# PostgreSQL (used by Docker Compose)
POSTGRES_DB=loja_3d
POSTGRES_USER=loja_3d
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_PORT=5432

# Go API
HTTP_PORT=8080
HTTP_HOST=127.0.0.1
APP_ENV=development
# Comma-separated exact origins. Never use * with credentialed requests.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:8081,http://127.0.0.1:8082
DATABASE_URL=postgres://loja_3d:change_me_for_local_development@localhost:5432/loja_3d?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT=5s

# Melhor Envio (use um token exclusivo do sandbox durante desenvolvimento)
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=your_sandbox_token
MELHOR_ENVIO_USER_AGENT=Loja 3D (dev@example.com)
MELHOR_ENVIO_ORIGIN_POSTAL_CODE=01001000
MELHOR_ENVIO_TIMEOUT=8s
SHIPPING_QUOTE_TTL=15m

# Mercado Pago: credenciais de teste e produção permanecem separadas.
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_SANDBOX_ACCESS_TOKEN=your_test_access_token
MERCADO_PAGO_SANDBOX_WEBHOOK_SECRET=your_test_webhook_secret
MERCADO_PAGO_PRODUCTION_ACCESS_TOKEN=leave_empty_in_development
MERCADO_PAGO_PRODUCTION_WEBHOOK_SECRET=leave_empty_in_development
MERCADO_PAGO_TIMEOUT=8s
MERCADO_PAGO_PIX_TTL=30m

# Proxy local restrito para expor somente o webhook por um túnel HTTPS autorizado.
WEBHOOK_PROXY_PORT=8090
WEBHOOK_PROXY_UPSTREAM=http://127.0.0.1:8080
WEBHOOK_PROXY_RATE_PER_MINUTE=60

# Local ingress split. All listeners and upstreams must remain on loopback.
PUBLIC_GATEWAY_ADDR=127.0.0.1:8081
ADMIN_GATEWAY_ADDR=127.0.0.1:8082
GATEWAY_NEXT_UPSTREAM=http://127.0.0.1:3000
GATEWAY_API_UPSTREAM=http://127.0.0.1:8080
PUBLIC_HOSTNAME=
ADMIN_HOSTNAME=
# Development-only second factor for the local admin ingress (minimum 24 chars).
# In production this must be empty; Cloudflare Access protects the private tunnel.
ZERO_TRUST_LOCAL_TOKEN=replace_with_a_random_local_value

# Cloudflare R2 (somente backend; nunca use credenciais em NEXT_PUBLIC_*)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=loja-3d-private
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# One-shot initial bootstrap. Enable only for the authorized first execution,
# then remove/disable it. E-mail and password are entered interactively.
ADMIN_BOOTSTRAP_ENABLED=false

# MFA TOTP: gere 32 bytes aleatórios e codifique em Base64. A chave pertence
# somente ao backend/secret manager; trocar a versão exige estratégia de rotação.
AUTH_MFA_ENCRYPTION_KEY=replace_with_base64_encoded_32_random_bytes
AUTH_MFA_KEY_VERSION=1
# Chaves antigas autorizadas apenas durante rotação: versão:chave-base64,...
AUTH_MFA_DECRYPTION_KEYS=
AUTH_REAUTH_TTL=5m
PASSWORD_BREACH_CHECK_URL=https://api.pwnedpasswords.com/range/
PASSWORD_BREACH_FAILURE_MODE=allow

# E-mail: "development" apenas em APP_ENV=development. Em produção permanece bloqueado até integrar um provedor real.
EMAIL_PROVIDER=development
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_PUBLIC_BASE_URL=http://localhost:3000
EMAIL_OUTBOX_ENCRYPTION_KEY=replace_with_base64_encoded_32_random_bytes
EMAIL_OUTBOX_KEY_VERSION=1
EMAIL_OUTBOX_DECRYPTION_KEYS=
EMAIL_MESSAGE_RETENTION=720h
EMAIL_EVENT_RETENTION=2160h
RESEND_WEBHOOK_SECRET=
# Future transactional provider configuration (not consumed until a real adapter is selected).
EMAIL_FROM=Lume Studio <no-reply@example.com>
EMAIL_REPLY_TO=support@example.com

# Next.js (copy this value to frontend/.env.local)
API_URL=http://localhost:8080
# Empty in the split-ingress deployment: browsers use their current origin.
NEXT_PUBLIC_API_URL=http://localhost:8080
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=your_test_public_key

